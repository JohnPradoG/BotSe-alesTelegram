# --- Telegram (https://my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# Nombre exacto del grupo/canal, o su ID numerico (ej: -1001234567890)
TG_CHAT=
# Opcional: IDs de usuarios autorizados a enviar senales (separados por coma). Vacio = cualquiera del grupo
TG_ALLOWED_SENDERS=

# --- Exchange (ccxt) ---
EXCHANGE=binanceusdm
API_KEY=
API_SECRET=
# Usar testnet/sandbox del exchange
SANDBOX=true

# --- Control ---
# true = solo registra lo que haria, NO envia ordenes
DRY_RUN=true

# --- Riesgo ---
# % del saldo USDT que se arriesga por operacion (distancia entrada->SL)
RISK_PCT=1.0
MAX_LEVERAGE=10
MAX_OPEN_TRADES=3
# Descarta senales cuyo precio actual se alejo mas de este % de la entrada
MAX_SLIPPAGE_PCT=0.5
# Si la senal no trae SL, se usa este % como stop (0 = rechazar senales sin SL)
DEFAULT_SL_PCT=0
